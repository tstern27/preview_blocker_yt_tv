{
  "manifest_version": 3,
  "name": "Preview Blocker for YouTube TV",
  "short_name": "Preview Blocker",
  "version": "1.0.0",
  "description": "Stops auto-playing previews on YouTube TV so you just see thumbnails. Videos still play when you click them.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://tv.youtube.com/*"],
      "js": ["block.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
